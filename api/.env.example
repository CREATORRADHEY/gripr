# GRIPR.STUDIO Phase 2 Backend Environment Configuration
# Copy this file to .env and configure local values

# Server configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Google Gemini AI Configuration
# Get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# CORS & Security
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
INTERNAL_AUTH_SECRET=gripr_dev_ops_secret_2026

# Mode toggles
DEMO_MODE=false
RATE_LIMIT_MAX=120
